@inherits LayoutComponentBase
@implements IDisposable
@inject SessaoDoPainel Sessao
@inject NavigationManager Navegacao

@if (NaTelaDeLogin)
{
    @Body
}
else if (Usuario is not null)
{
    <div class="lg:flex">
        <aside class="sticky top-0 hidden h-dvh w-64 shrink-0 flex-col border-r border-navy-100 bg-white p-5 lg:flex">
            <a href="/admin" class="flex items-center gap-2.5">
                <span class="grid size-10 place-items-center rounded-full border border-gold-400 bg-navy-800 text-sm font-semibold text-gold-300">BA</span>
                <span class="leading-tight">
                    <span class="block text-sm font-semibold">Painel</span>
                    <span class="block text-xs text-navy-500">Bruna Albuquerque</span>
                </span>
            </a>
            <nav class="mt-8 flex flex-col gap-1" aria-label="Menu do painel">
                @foreach (var item in Itens)
                {
                    <a href="@item.Href" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm @(Ativo(item) ? "bg-navy-800 font-medium text-white" : "text-navy-700 hover:bg-navy-50")">
                        <Icone Nome="@item.Icone" Classe="size-5" /> @item.Rotulo
                    </a>
                }
            </nav>
            <div class="mt-auto space-y-1 border-t border-navy-100 pt-4 text-sm">
                <a href="/" target="_blank" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-navy-700 hover:bg-navy-50">
                    <Icone Nome="external-link" Classe="size-5" /> Ver o site
                </a>
                <button type="button" @onclick="Sair" class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-navy-700 hover:bg-navy-50">
                    <Icone Nome="log-out" Classe="size-5" /> Sair
                </button>
                <p class="truncate px-3 pt-2 text-xs text-navy-400">@Usuario.Email</p>
            </div>
        </aside>

        @* Celular: barra superior + navegação inferior *@
        <header class="sticky top-0 z-30 flex h-14 items-center justify-between border-b border-navy-100 bg-white px-4 lg:hidden">
            <a href="/admin" class="text-sm font-semibold">Painel · Bruna</a>
            <div class="flex items-center gap-1">
                <a href="/" target="_blank" class="grid size-10 place-items-center rounded-full text-navy-600 hover:bg-navy-50" aria-label="Ver o site">
                    <Icone Nome="external-link" Classe="size-5" />
                </a>
                <button type="button" @onclick="Sair" class="grid size-10 place-items-center rounded-full text-navy-600 hover:bg-navy-50" aria-label="Sair">
                    <Icone Nome="log-out" Classe="size-5" />
                </button>
            </div>
        </header>

        <div class="min-w-0 flex-1 px-4 pt-5 pb-28 sm:px-6 lg:px-10 lg:pt-8 lg:pb-12">@Body</div>

        <nav class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-5 border-t border-navy-100 bg-white pb-[env(safe-area-inset-bottom)] lg:hidden" aria-label="Menu do painel">
            @foreach (var item in Itens)
            {
                <a href="@item.Href" class="flex flex-col items-center gap-1 py-2.5 text-[10px] @(Ativo(item) ? "font-semibold text-navy-900" : "text-navy-500")">
                    <Icone Nome="@item.Icone" Classe="@($"size-5 {(Ativo(item) ? "text-gold-500" : "")}")" />
                    @(item.Curto ?? item.Rotulo)
                </a>
            }
        </nav>
    </div>
}
else
{
    <div class="grid min-h-dvh place-items-center text-sm text-navy-500">Carregando…</div>
}

@* Aparece quando uma tela do painel encontra um erro inesperado *@
<div id="blazor-error-ui" data-nosnippet>
    Algo deu errado nesta tela.
    <a href="." class="reload">Recarregar</a>
    <button type="button" class="dismiss" aria-label="Fechar aviso">🗙</button>
</div>

@code {
    private sealed record Item(string Href, string Rotulo, string Icone, bool Exato = false, string? Curto = null);

    private static readonly Item[] Itens =
    [
        new("/admin", "Início", "layout-dashboard", Exato: true),
        new("/admin/imoveis", "Imóveis", "house"),
        new("/admin/depoimentos", "Depoimentos", "message-square-quote", Curto: "Depoim."),
        new("/admin/paginas", "Páginas", "file-text"),
        new("/admin/configuracoes", "Configurações", "settings", Curto: "Config."),
    ];

    private UsuarioDoPainel? Usuario { get; set; }

    private string Caminho => "/" + Navegacao.ToBaseRelativePath(Navegacao.Uri).Split('?')[0];
    private bool NaTelaDeLogin => Caminho.Equals("/admin/entrar", StringComparison.OrdinalIgnoreCase);

    private bool Ativo(Item item) => item.Exato ? Caminho == item.Href : Caminho.StartsWith(item.Href, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Sessao.Mudou += AoMudarASessao;
        Navegacao.LocationChanged += AoNavegar;
        await Conferir();
    }

    private async Task Conferir()
    {
        if (NaTelaDeLogin) return;
        var sessao = await Sessao.ObterSessao();
        if (sessao is null)
        {
            Navegacao.NavigateTo($"/admin/entrar?volta={Uri.EscapeDataString(Caminho)}");
            return;
        }
        Usuario = new(sessao.Usuario.Nome, sessao.Usuario.Email);
    }

    private void AoNavegar(object? _, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs __) =>
        _ = InvokeAsync(async () => { await Conferir(); StateHasChanged(); });

    private void AoMudarASessao() => _ = InvokeAsync(async () => { Usuario = null; await Conferir(); StateHasChanged(); });

    private async Task Sair()
    {
        await Sessao.Sair();
        Navegacao.NavigateTo("/admin/entrar");
    }

    public void Dispose()
    {
        Sessao.Mudou -= AoMudarASessao;
        Navegacao.LocationChanged -= AoNavegar;
    }

    private sealed record UsuarioDoPainel(string Nome, string Email);
}
