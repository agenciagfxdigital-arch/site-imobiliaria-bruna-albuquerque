@page "/sobre"
@inject SiteApi Api
@inject DadosDoSite Dados

<Metadados Titulo="Quem é a Bruna" Caminho="/sobre"
           Descricao="Conheça a Bruna Albuquerque, corretora de imóveis em Videira/SC, há 7 anos no mercado imobiliário e com foco no primeiro imóvel e no Minha Casa Minha Vida." />

@if (Conteudo is { } c)
{
    var numeros = new[] { (c.AnosExperiencia, "anos de experiência"), (c.FamiliasAtendidas, "famílias atendidas") }
        .Where(n => !string.IsNullOrWhiteSpace(n.Item1)).ToList();

    @* Abertura *@
    <section class="container-site grid items-center gap-8 pt-8 sm:pt-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div class="relative mx-auto aspect-[4/5] w-full max-w-sm overflow-hidden rounded-[2rem] bg-navy-100 shadow-2xl shadow-navy-900/15 lg:max-w-none">
            <FotoDaBruna Url="@c.Foto" Prioridade />
        </div>
        <div>
            <p class="eyebrow">Quem é a Bruna</p>
            <h1 class="mt-3 text-4xl font-semibold text-navy-900 sm:text-5xl">@c.Titulo</h1>
            <p class="mt-3 text-lg text-navy-600">@c.Subtitulo</p>
            @if (!string.IsNullOrEmpty(Configuracoes.Creci))
            {
                <p class="mt-4 inline-flex rounded-full bg-navy-100 px-4 py-1.5 text-sm font-semibold text-navy-800">@Configuracoes.Creci</p>
            }
            @if (numeros.Count > 0)
            {
                <dl class="mt-8 flex flex-wrap gap-4">
                    @foreach (var (valor, rotulo) in numeros)
                    {
                        <div class="card min-w-36 px-6 py-5">
                            <dt class="sr-only">@rotulo</dt>
                            <dd>
                                <span class="block text-4xl font-semibold text-gold-500">@valor</span>
                                <span class="text-sm text-navy-600">@rotulo</span>
                            </dd>
                        </div>
                    }
                </dl>
            }
        </div>
    </section>

    @* Minha história *@
    <section class="container-site mt-20" aria-labelledby="historia">
        <div class="mx-auto max-w-3xl">
            <p class="eyebrow">Minha história</p>
            <h2 id="historia" class="section-title mt-2">Por que eu escolhi o primeiro imóvel</h2>
            <Paragrafos Texto="@c.Historia" Classe="prose-bruna mt-6 text-lg" />
        </div>
    </section>

    @* Como eu trabalho *@
    <section class="container-site mt-20" aria-labelledby="como-trabalho">
        <CabecalhoDeSecao Chamada="Como eu trabalho" Titulo="Do primeiro contato até a chave" Id="como-trabalho" />
        <div class="mt-8"><Passos Lista="c.Passos" /></div>
    </section>

    @if (Video.Incorporar(c.VideoUrl) is not null)
    {
        <section class="container-site mt-20" aria-labelledby="video">
            <CabecalhoDeSecao Chamada="Vídeo" Titulo="Quem sou eu e como eu trabalho" Centro Id="video" />
            <div class="mt-8"><VideoIncorporado Url="@c.VideoUrl" Titulo="Quem sou eu e como eu trabalho" /></div>
        </section>
    }

    @if (c.Entregas.Count > 0)
    {
        <section class="container-site mt-20" aria-labelledby="entregas">
            <CabecalhoDeSecao Chamada="Entregas de chave" Titulo="Cada chave, uma história" Texto="Fotos compartilhadas com autorização das famílias." Id="entregas" />
            <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                @for (var i = 0; i < c.Entregas.Count; i++)
                {
                    <div class="relative aspect-square overflow-hidden rounded-2xl bg-navy-100">
                        <img src="@c.Entregas[i]" alt="Entrega de chave @(i + 1)" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
                    </div>
                }
            </div>
        </section>
    }

    @if (TodosOsDepoimentos.Count > 0)
    {
        <section class="container-site mt-20" aria-labelledby="depoimentos">
            <CabecalhoDeSecao Chamada="Depoimentos" Titulo="O que dizem as famílias" Id="depoimentos" />
            <div class="mt-8"><Depoimentos Lista="TodosOsDepoimentos" /></div>
        </section>
    }

    <ChamadaFinal Titulo="@c.CtaTitulo" Texto="Me conta o seu momento. A gente conversa sem compromisso." Local="sobre_cta" />
}

@code {
    private ConteudoSobre? Conteudo { get; set; }
    private ConfiguracoesResponse Configuracoes { get; set; } = ConfiguracoesResponse.Padrao();
    private IReadOnlyList<DepoimentoResponse> TodosOsDepoimentos { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var depoimentos = DadosDoSite.Exigir(Api.Depoimentos(soDaHome: false));
        Configuracoes = await Dados.Configuracoes();
        Conteudo = (await Dados.Paginas()).Sobre;
        TodosOsDepoimentos = await depoimentos;
    }
}
