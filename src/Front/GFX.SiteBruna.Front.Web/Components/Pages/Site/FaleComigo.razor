@page "/contato"
@inject DadosDoSite Dados

<Metadados Titulo="Contato" Caminho="/contato"
           Descricao="Fale com a Bruna Albuquerque, corretora de imóveis em Videira/SC, pelo WhatsApp, Instagram ou e-mail." />

<div class="container-site max-w-3xl pt-8 sm:pt-12">
    <p class="eyebrow">Contato</p>
    <h1 class="mt-3 text-4xl font-semibold text-navy-900">Vamos conversar?</h1>
    <p class="mt-4 text-lg leading-relaxed text-navy-600">
        O jeito mais rápido de falar comigo é pelo WhatsApp. Me chame por onde preferir que eu te respondo com calma.
    </p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        <li>
            <BotaoWhatsapp Local="contato_pagina" ComIcone="false" Classe="card flex h-full items-center gap-4 p-5 transition-shadow hover:shadow-lg">
                <span class="grid size-12 place-items-center rounded-full bg-whatsapp/10 text-whatsapp-dark"><Icone Nome="whatsapp" Classe="size-6" /></span>
                <span>
                    <span class="block font-semibold text-navy-900">WhatsApp</span>
                    <span class="text-sm text-navy-600">@Formato.Telefone(Configuracoes.Whatsapp)</span>
                </span>
            </BotaoWhatsapp>
        </li>
        @if (Contato.Instagram(Configuracoes.Instagram) is { Length: > 0 } instagram)
        {
            <li>
                <a href="@instagram" target="_blank" rel="noopener noreferrer" class="card flex h-full items-center gap-4 p-5 transition-shadow hover:shadow-lg">
                    <span class="grid size-12 place-items-center rounded-full bg-gold-100 text-gold-700"><Icone Nome="instagram" Classe="size-6" /></span>
                    <span>
                        <span class="block font-semibold text-navy-900">Instagram</span>
                        <span class="text-sm text-navy-600">@Contato.ArrobaDoInstagram(Configuracoes.Instagram)</span>
                    </span>
                </a>
            </li>
        }
        @if (!string.IsNullOrEmpty(Configuracoes.Email))
        {
            <li>
                <a href="mailto:@Configuracoes.Email" class="card flex h-full items-center gap-4 p-5 transition-shadow hover:shadow-lg">
                    <span class="grid size-12 place-items-center rounded-full bg-navy-100 text-navy-700"><Icone Nome="mail" Classe="size-6" /></span>
                    <span class="min-w-0">
                        <span class="block font-semibold text-navy-900">E-mail</span>
                        <span class="block truncate text-sm text-navy-600">@Configuracoes.Email</span>
                    </span>
                </a>
            </li>
        }
        <li class="card flex items-center gap-4 p-5">
            <span class="grid size-12 place-items-center rounded-full bg-navy-100 text-navy-700"><Icone Nome="map-pin" Classe="size-6" /></span>
            <span>
                <span class="block font-semibold text-navy-900">Atendimento</span>
                <span class="text-sm text-navy-600">@Configuracoes.Cidade e região · @Configuracoes.Creci</span>
            </span>
        </li>
    </ul>
</div>

@code {
    private ConfiguracoesResponse Configuracoes { get; set; } = ConfiguracoesResponse.Padrao();

    protected override async Task OnInitializedAsync() => Configuracoes = await Dados.Configuracoes();
}
