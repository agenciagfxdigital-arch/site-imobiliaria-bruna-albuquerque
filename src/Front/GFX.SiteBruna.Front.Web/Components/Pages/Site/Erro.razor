@page "/erro"
@using System.Diagnostics

@* Erro no servidor. Só mostra o código da requisição (para achar no log); nenhum detalhe técnico vai para quem visita. *@
<Metadados Titulo="Algo deu errado" SemIndice />

<div class="container-site flex flex-col items-center py-24 text-center">
    <p class="eyebrow">Algo deu errado</p>
    <h1 class="mt-3 text-3xl font-semibold">Não consegui abrir esta página agora</h1>
    <p class="mt-3 max-w-md text-navy-600">Tente de novo em alguns instantes. Se preferir, me chama no WhatsApp que eu te atendo por lá.</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Voltar para o início</a>
        <BotaoWhatsapp Local="pagina_erro">Falar com a Bruna</BotaoWhatsapp>
    </div>
    @if (!string.IsNullOrEmpty(CodigoDoErro))
    {
        <p class="mt-8 text-xs text-navy-400">Código do erro: <code>@CodigoDoErro</code></p>
    }
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? CodigoDoErro => Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
