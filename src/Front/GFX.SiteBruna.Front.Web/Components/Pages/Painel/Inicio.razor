@page "/admin"
@inject ImovelApi Imoveis

<PageTitle>Início | Painel</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-semibold">Início</h1>
        <p class="mt-1 text-sm text-navy-600">Resumo dos imóveis. As métricas de visitas e de cliques no WhatsApp vão aparecer aqui.</p>
    </div>

    <Mensagem Erro="@Erro" />

    @if (Lista is not null)
    {
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            @foreach (var (rotulo, quantidade, status) in Contagens())
            {
                <a href="@($"/admin/imoveis?status={status}")" class="card p-5 transition-shadow hover:shadow-lg">
                    <span class="block text-3xl font-semibold text-navy-900">@quantidade</span>
                    <span class="text-sm text-navy-600">@rotulo</span>
                </a>
            }
        </div>

        <section class="card p-5">
            <div class="flex items-center justify-between gap-3">
                <h2 class="font-semibold text-navy-900">Alterados por último</h2>
                <a href="/admin/imoveis" class="text-sm font-medium text-navy-700 hover:underline">Ver todos</a>
            </div>
            <ul class="mt-3 divide-y divide-navy-100">
                @foreach (var imovel in Lista.Take(6))
                {
                    <li class="flex items-center gap-3 py-3">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-lg bg-navy-100">
                            @if (imovel.CapaUrl is { } capa)
                            {
                                <img src="@capa" alt="" class="absolute inset-0 size-full object-cover" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <a href="@($"/admin/imoveis/{imovel.Id}")" class="line-clamp-1 text-sm font-medium hover:underline">@imovel.Titulo</a>
                            <p class="text-xs text-navy-500">@imovel.Codigo · @Rotulos.Status(imovel.Status) · @Formato.Data(imovel.AtualizadoEm, comHora: true)</p>
                        </div>
                    </li>
                }
            </ul>
        </section>

        <a href="/admin/imoveis/novo" class="btn-primary"><Icone Nome="plus" Classe="size-4" /> Novo imóvel</a>
    }
</div>

@code {
    private List<ImovelResumoResponse>? Lista { get; set; }
    private string? Erro { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var resposta = await Imoveis.Listar(null, null, null);
        if (resposta.Sucesso) Lista = resposta.Dados;
        else Erro = string.Join(" ", resposta.Mensagens);
    }

    private IEnumerable<(string, int, StatusImovel)> Contagens()
    {
        yield return ("no site", Lista!.Count(i => i.Status == StatusImovel.Ativo), StatusImovel.Ativo);
        yield return ("rascunhos", Lista!.Count(i => i.Status == StatusImovel.Rascunho), StatusImovel.Rascunho);
        yield return ("pausados", Lista!.Count(i => i.Status == StatusImovel.Pausado), StatusImovel.Pausado);
        yield return ("vendidos", Lista!.Count(i => i.Status == StatusImovel.Vendido), StatusImovel.Vendido);
    }
}
