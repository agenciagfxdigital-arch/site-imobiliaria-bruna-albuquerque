<label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-navy-100 px-4 py-2.5">
    <input type="checkbox" class="size-5 accent-navy-800" checked="@Valor" @onchange="e => ValorChanged.InvokeAsync(e.Value is true)" />
    <span class="text-[15px]">
        @Rotulo
        @if (!string.IsNullOrEmpty(Dica))
        {
            <span class="block text-xs text-navy-500">@Dica</span>
        }
    </span>
</label>

@code {
    [Parameter, EditorRequired] public string Rotulo { get; set; } = "";
    [Parameter] public string? Dica { get; set; }
    [Parameter] public bool Valor { get; set; }
    [Parameter] public EventCallback<bool> ValorChanged { get; set; }
}
