<div class="@(Centro ? "mx-auto max-w-2xl text-center" : "max-w-2xl")">
    @if (!string.IsNullOrEmpty(Chamada))
    {
        <p class="eyebrow">@Chamada</p>
    }
    <h2 id="@Id" class="section-title mt-2">@Titulo</h2>
    @if (!string.IsNullOrEmpty(Texto))
    {
        <p class="mt-3 leading-relaxed text-navy-600">@Texto</p>
    }
</div>

@code {
    /// <summary>O texto pequeno e dourado acima do título.</summary>
    [Parameter] public string? Chamada { get; set; }
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Texto { get; set; }
    [Parameter] public bool Centro { get; set; }
    [Parameter] public string? Id { get; set; }
}
