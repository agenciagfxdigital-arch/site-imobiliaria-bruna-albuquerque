<ul class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[13px] text-navy-600">
    @foreach (var (icone, rotulo, curto) in Itens())
    {
        <li class="inline-flex items-center gap-1.5" title="@rotulo">
            <Icone Nome="@icone" Classe="size-4 text-gold-500" />
            @if (Compacto)
            {
                <span><span class="sr-only">@rotulo</span><span aria-hidden="true">@curto</span></span>
            }
            else
            {
                @rotulo
            }
        </li>
    }
</ul>

@code {
    [Parameter] public int Quartos { get; set; }
    [Parameter] public int Banheiros { get; set; }
    [Parameter] public int Vagas { get; set; }
    [Parameter] public decimal? Area { get; set; }
    /// <summary>Só os números (cartão); a descrição completa fica para leitores de tela.</summary>
    [Parameter] public bool Compacto { get; set; }

    private IEnumerable<(string Icone, string Rotulo, string Curto)> Itens()
    {
        if (Quartos > 0) yield return ("bed-double", Formato.Plural(Quartos, "quarto", "quartos"), $"{Quartos}");
        if (Banheiros > 0) yield return ("bath", Formato.Plural(Banheiros, "banheiro", "banheiros"), $"{Banheiros}");
        if (Vagas > 0) yield return ("car", Formato.Plural(Vagas, "vaga", "vagas"), $"{Vagas}");
        if (Area > 0) yield return ("ruler", Formato.Area(Area), Formato.Area(Area));
    }
}
