<section class="container-site mt-20">
    <div class="relative overflow-hidden rounded-[2rem] bg-navy-800 px-6 py-12 text-center sm:px-12 sm:py-16">
        <div class="pointer-events-none absolute -top-20 -right-20 size-64 rounded-full bg-gold-400/15" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-24 -left-16 size-56 rounded-full bg-gold-400/10" aria-hidden="true"></div>
        <h2 class="relative text-2xl font-semibold text-white sm:text-3xl">@Titulo</h2>
        @if (!string.IsNullOrEmpty(Texto))
        {
            <p class="relative mx-auto mt-3 max-w-xl text-navy-100">@Texto</p>
        }
        <BotaoWhatsapp Local="@Local" Classe="btn-whatsapp relative mt-8 px-8">Me chama no WhatsApp</BotaoWhatsapp>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Texto { get; set; }
    [Parameter, EditorRequired] public string Local { get; set; } = "";
}
