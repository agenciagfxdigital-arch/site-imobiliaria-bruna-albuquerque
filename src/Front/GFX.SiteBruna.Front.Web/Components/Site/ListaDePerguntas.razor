<div class="divide-y divide-navy-100 overflow-hidden rounded-[var(--radius-card)] bg-white shadow-[var(--shadow-card)]">
    @foreach (var f in Lista)
    {
        <details class="group">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium text-navy-900 [&::-webkit-details-marker]:hidden">
                @f.Pergunta
                <Icone Nome="chevron-down" Classe="size-5 shrink-0 text-gold-500 transition-transform group-open:rotate-180" />
            </summary>
            <p class="px-5 pb-5 text-[15px] leading-relaxed whitespace-pre-line text-navy-600">@f.Resposta</p>
        </details>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FaqResponse> Lista { get; set; } = [];
}
