@if (Lista.Count > 0)
{
    <div class="no-scrollbar -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 lg:grid-cols-3">
        @foreach (var d in Lista)
        {
            <figure class="card flex w-[85%] shrink-0 snap-center flex-col overflow-hidden sm:w-auto">
                @if (!string.IsNullOrEmpty(d.FotoUrl))
                {
                    <div class="relative aspect-[4/3] bg-navy-100">
                        <img src="@d.FotoUrl" alt="Entrega de chave — @d.Nome" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
                    </div>
                }
                <div class="flex flex-1 flex-col p-6">
                    <Icone Nome="quote" Classe="size-6 text-gold-400" />
                    <blockquote class="mt-3 flex-1 text-[15px] leading-relaxed text-navy-700">@d.Texto</blockquote>
                    <figcaption class="mt-4 text-sm font-semibold text-navy-900">@d.Nome</figcaption>
                </div>
            </figure>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DepoimentoResponse> Lista { get; set; } = [];
}
