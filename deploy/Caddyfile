# HTTPS automático e entrada única do site (docs/DEPLOY.md).
{$DOMINIO} {
	encode zstd gzip

	# Só o webhook do WhatsApp chega na Api pela internet
	handle /api/whatsapp/webhook* {
		reverse_proxy api:8080
	}

	# Aviso de conteúdo novo: rota interna, a Api chama o Front direto pela rede do Docker
	handle /_cache/* {
		respond 404
	}

	# O painel tem endereço próprio
	@painel path /admin /admin/*
	handle @painel {
		redir https://{$DOMINIO_ADMIN}{uri} 302
	}

	handle {
		reverse_proxy front:8080
	}
}

{$DOMINIO_SEM_WWW} {
	redir https://{$DOMINIO}{uri} permanent
}

# Painel. É o mesmo Front.Web: além de /admin, ele precisa do WebSocket do Blazor, dos arquivos estáticos e das fotos
{$DOMINIO_ADMIN} {
	encode zstd gzip

	# Fora dos buscadores; defer para substituir o cabeçalho que o Front já manda em /admin
	header {
		defer
		X-Robots-Tag "noindex, nofollow"
	}

	handle /_cache/* {
		respond 404
	}

	@raiz path /
	handle @raiz {
		redir /admin 302
	}

	# Os links "ver no site" do painel são relativos
	handle /imovel/* {
		redir https://{$DOMINIO}{uri} 302
	}

	handle {
		reverse_proxy front:8080
	}
}
