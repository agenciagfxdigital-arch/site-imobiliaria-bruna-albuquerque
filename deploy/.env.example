# Modelo do deploy/.env da VPS (docs/DEPLOY.md). Copie para .env e preencha: o .env fica fora do git.
# Gere valores aleatórios com: openssl rand -base64 48 | tr -d '/+=\n'
# Guarde uma cópia do .env no gerenciador de senhas.

# Endereço principal do site e o que redireciona para ele
DOMINIO=www.brunaalbuquerque.com.br
DOMINIO_SEM_WWW=brunaalbuquerque.com.br

# Supabase: Session pooler, com SSL. Valor entre aspas simples, por causa dos ponto e vírgula
CONEXAO_BANCO='Host=<host do pooler>;Port=5432;Database=postgres;Username=postgres.<ref do projeto>;Password=<senha>;SSL Mode=Require'

# Mínimo de 32 caracteres. Trocar desconecta quem está no painel
JWT_KEY=
# A Api usa esta chave para avisar o Front de conteúdo novo
CHAVE_DO_CACHE=

# Assistente do WhatsApp: ligue depois de configurar o webhook na Meta
WHATSAPP_HABILITADO=false
WHATSAPP_MODO=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Backup das fotos (deploy/backup-fotos.sh): destino configurado no rclone, no formato <remoto>:<pasta>
BACKUP_DESTINO=
